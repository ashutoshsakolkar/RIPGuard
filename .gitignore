```gitignore
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE settings
.vscode/
.idea/

# Build and distribution
build/
dist/
*.egg-info/

# Logs
*.log

# OS-generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
```
